# jake hub configuration — the main-host-side server.
#
# This is the single file the hub reads at startup. It lives under the data directory, outside the
# git tree, exactly as BMO keeps its own; the repo carries only this example. Copy it to hub.env
# and fill in the two required keys.

# The address the agent-facing WebSocket server binds to. 0.0.0.0 to accept from the LAN and NPM.
#JAKE_HUB_HOST=0.0.0.0

# The port the agent-facing WebSocket server listens on. Positive integer.
#JAKE_HUB_PORT=8790

# REQUIRED. The shared secret an agent must present as `Authorization: Bearer <secret>`. Must match
# the agent's JAKE_SECRET. Never committed.
JAKE_SECRET=
# The key credentials of one agent name are made with: `<name>.<hex HMAC-SHA256 of the name>`. Optional; without
# it only JAKE_SECRET admits an agent. Whoever mints such credentials holds the same value. Never committed.
#JAKE_AGENT_KEY=

# The loopback control API the console and 비모 drive the hub through. Bound to 127.0.0.1 alone.
# Positive integer.
#JAKE_CONTROL_PORT=8791

# REQUIRED. The token every control-API request carries as `Authorization: Bearer <token>`.
# Distinct from the agent secret. Never committed.
JAKE_CONTROL_TOKEN=

# The largest single frame payload the hub will accept from the agent, in bytes. Positive integer.
#JAKE_MAX_PAYLOAD_BYTES=16777216

# How often the hub pings each agent, in milliseconds, and how many intervals may pass without a pong
# before it drops the agent as dead. Positive integers.
#JAKE_HUB_PING_INTERVAL_MS=15000
#JAKE_HUB_MISSED_PONG_LIMIT=3

# How many unwritten bytes an agent socket may hold before the hub stops handing it more of an upload
# until half of them have gone out. Positive integer.
#JAKE_HUB_SOCKET_BACKLOG_BYTES=4194304
