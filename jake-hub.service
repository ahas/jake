[Unit]
Description=jake hub — the main-host side of the remote-control tunnel
After=network-online.target
Wants=network-online.target
# Without its config file the hub has neither the shared secret it authenticates the agent with nor
# the control token the console presents, so it could only crash-loop; don't start at all until the
# file is in place. The file lives with the runtime data rather than in the checkout: a secret inside
# a git tree is an untracked file, and an untracked file is one `git clean` away from gone. The hub
# reads this same file itself, so the condition guards exactly what the process needs.
ConditionPathExists=%h/.local/share/jake/hub.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# The hub's binary in the deploy tree: the release the testbed built from the commit it records live
# (docs/deploy.md, step 8). A deployment flips the tree and restarts the unit, so the hub runs exactly
# the deployed commit and nothing in a checkout or its build directory.
WorkingDirectory=%h/.local/share/jake
ExecStart=%h/.local/share/jake-hub/deploy/bin/jake-hub
SyslogIdentifier=jake-hub
Restart=always
RestartSec=5
# The same PATH BMO's units carry, so a tool the hub reaches for is found the same way whether it was
# started by systemd or from a shell.
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
# The service a testbed deployment restarts and waits on until `jake-hub up` answers (docs/deploy.md,
# step 8); systemd ignores the key.
X-BMO-Deploy=bot
