{
  "name": "jake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "bun-types": "^1.3.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "check:types": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "check:rust": "cargo clippy --offline --workspace --all-targets -- -D warnings && cargo fmt --all --check",
    "test:rust": "cargo test --offline --workspace",
    "test": "bun test",
    "check": "bun run check:types && bun run check:rust && bun run test:rust && bun run test",
    "check:desktop": "cd desktop && cargo clippy --all-targets -- -D warnings && cargo fmt --check && cargo test",
    "build": "bun scripts/build.ts",
    "release:desktop": "systemd-run --user --scope --quiet -p MemoryMax=8G bun scripts/desktop-release.ts --publish /var/www/ahas-ai/bmo/jake/desktop --keys \"$HOME/.local/share/bmo/data/env\""
  }
}
