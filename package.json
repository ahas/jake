{
  "name": "jake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "bun-types": "^1.3.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "check:types": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "check:rust": "cargo clippy --offline --workspace --all-targets -- -D warnings && cargo fmt --all --check",
    "check:cli": "bun scripts/check-hub-cli.ts --build",
    "test:rust": "cargo test --offline --workspace",
    "test": "bun test",
    "check": "bun run check:types && bun run check:rust && bun run check:cli && bun run test:rust && bun run test",
    "build": "bun scripts/build.ts"
  }
}
