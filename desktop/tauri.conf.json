{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMO",
  "version": "0.2.1",
  "identifier": "io.ahas.jake.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "appimage", "deb"],
    "publisher": "ahas",
    "shortDescription": "BMO console with a built-in jake agent",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bmo"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFN0UwN0RFMzkwMjM2OTIKUldTU05nSTUzZ2QrTHJ0VmQyZlhpQzR5UWc5R0c4TGxxMUc5eE9JWTVjUko5WmZqbzdXQXpWVnAK",
      "endpoints": ["https://github.com/ahas/jake/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
