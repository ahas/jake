# jake agent configuration — the Windows-side program.
#
# This is the single file the agent reads at startup. The installer writes the real file beside
# the agent's exe from what it asks 하스 at install time; nothing here is compiled into the binary.
# The repo carries only this example. Copy it to agent.env and fill in the three required keys.

# REQUIRED. The hub this agent dials out to. wss:// through the public name in production,
# ws:// on the LAN for a local test.
JAKE_HUB_URL=

# REQUIRED. The shared secret, sent as `Authorization: Bearer <secret>` at the WebSocket upgrade.
# Must match the hub's JAKE_SECRET exactly. Entered at install time; never committed.
JAKE_SECRET=

# REQUIRED. This agent's identity. The hub expects exactly one; a second connection presenting the
# same name supersedes the first.
JAKE_AGENT_NAME=

# How often the agent sends a ping and refreshes its liveness, in milliseconds. Positive integer.
#JAKE_HEARTBEAT_MS=15000

# How often the self-healing pair rewrites its autostart anchors and refreshes its heartbeat, in
# milliseconds. Positive integer.
#JAKE_TICK_MS=60000

# How old a peer's heartbeat may grow before the watchdog treats it as dead and relaunches it, in
# milliseconds. Keep it a few ticks so one slow tick does not trigger a false relaunch. Positive
# integer.
#JAKE_WATCHDOG_STALE_MS=180000

# The largest single frame payload the agent will encode or accept, in bytes. Positive integer.
#JAKE_MAX_PAYLOAD_BYTES=16777216

# The most output a single exec command may stream before jake stops it, in bytes. Guards the hub
# against a runaway command (a recursive listing of a whole drive). Positive integer.
#JAKE_EXEC_MAX_OUTPUT_BYTES=8388608

# The wall-clock ceiling on a single exec command before jake stops it, in milliseconds. A command
# that runs past it is terminated with a stated reason. Positive integer.
#JAKE_EXEC_TIMEOUT_MS=300000

# The ceiling of the first redial delay after a lost connection, in milliseconds; it doubles with
# each failed attempt, and each delay is a random point below its ceiling. Positive integer.
#JAKE_REDIAL_BASE_MS=1000

# The ceiling the redial delay never exceeds, however long the hub stays away, in milliseconds.
# Positive integer.
#JAKE_REDIAL_CAP_MS=60000
